#!/usr/bin/env bash
dir="${1:-.}"

find "$dir" -type f \( -name '*.c' -o -name '*.js' -o -name '*.py' \) | while read -r f; do
    first=$(head -n 1 "$f")
    case "$f" in
        *.py)
            [[ "$first" =~ ^[[:space:]]*# ]] && echo "$f: да" || echo "$f: нет"
            ;;
        *.c|*.js)
            [[ "$first" =~ ^[[:space:]]*(//|/\*) ]] && echo "$f: да" || echo "$f: нет"
            ;;
    esac
done



