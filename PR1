#!/usr/bin/env bash
dir="${1:-.}"
declare -A seen

while IFS= read -r -d '' f; do
    h=$(md5sum "$f" | awk '{print $1}')
    if [[ -n "${seen[$h]}" ]]; then
        echo "${seen[$h]} == $f"
    else
        seen[$h]="$f"
    fi
done < <(find "$dir" -type f -print0)


